# =============================================================================
# CORE APPLICATION
# =============================================================================

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your_opensearch_password_here
OPENSEARCH_INDEX_NAME=arxiv_papers

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=rag_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# AI / EMBEDDINGS
# =============================================================================

# Jina AI (free API key at https://jina.ai)
JINA_API_KEY=your_jina_api_key_here

# Ollama (local — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Langfuse (https://langfuse.com — free tier available)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=http://localhost:3000

# =============================================================================
# CLIENTS
# =============================================================================

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# APP SETTINGS
# =============================================================================

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Retrieval settings
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
